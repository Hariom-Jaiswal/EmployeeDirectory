# Database
# MySQL
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/employee_directory

# SQLite (to evaluate):
# DATABASE_URL=sqlite+aiosqlite:///./employees.db

# MySQL Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

#Configuration
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="Employee Directory Search System"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
